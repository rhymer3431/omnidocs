{
  "name": "omnidocs",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rhwp": "node scripts/smoke-rhwp.mjs",
    "test:docx": "node scripts/test-docx-roundtrip.mjs",
    "test:studio": "node scripts/check-rhwp-studio.mjs",
    "test:compat": "npm test && npm run test:studio && npm run test:rhwp && npm run test:docx",
    "vendor:rhwp-studio": "node scripts/vendor-rhwp-studio.mjs",
    "prepare:rhwp": "node scripts/copy-rhwp-wasm.mjs",
    "postinstall": "npm run prepare:rhwp"
  },
  "dependencies": {
    "@rhwp/core": "0.8.6",
    "@rhwp/editor": "0.8.6",
    "jszip": "^3.10.1",
    "mammoth": "1.12.2",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "^21.1.7",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.0.1",
    "docx": "^9.5.1",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "8.2.2",
    "vitest": "3.2.4"
  }
}
